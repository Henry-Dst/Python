#Want function for if point is on window
def point_on_window(pt, win): #Are assuming the point is in the window
    T = 1e-9
    dx1 = abs(pt[0] - win[0][0])
    dx2 = abs(pt[0] - win[0][1])
    dy1 = abs(pt[1] - win[1][0])
    dy2 = abs(pt[1] - win[1][1])
    if dx1 < T or dx2 < T or dy1 < T or dy2 < T:
        return True
    return False

#Want function for which window edge point is on
def point_on_window_edge(pt, win): #Are assuming the point is in the window
    T = 1e-9
    dx1 = abs(pt[0] - win[0][0])
    dx2 = abs(pt[0] - win[0][1])
    dy1 = abs(pt[1] - win[1][0])
    dy2 = abs(pt[1] - win[1][1])
    #going to assume it cannot perfectly hit the corner due to floating points
    if dx1 <= T:
        return 0
    if dx2 <= T:
        return 1
    if dy1 <= T:
        return 2
    if dy2 <= T:
        return 3 #This way we know which edge the point is on
    return False

