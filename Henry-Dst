def reflect_point_across_seg(point, seg):
    T = 1e-9
    dx = seg[1][0] - seg[0][0]
    dy = seg[1][1] - seg[0][1]
    mod_seg2 = dx**2 + dy**2
    if mod_seg2 < T:
        return None
    vx = point[0] - seg[0][0]
    vy = point[1] - seg[0][1] #Vector seg[0] to point
    dp = vx*dx + vy*dy #Dot product between above vectors
    t = dp / mod_seg2 #Scalar for projection
    rx = 2*(seg[0][0] + t*dx) - point[0]
    ry = 2*(seg[0][1] + t*dy) - point[1]
    reflected_point = [rx, ry]
    return reflected_point
    
