import numpy as np
np.set_printoptions(legacy = '1.25') #Stops output being np.float()

#Due to rounding errors from floating point calculations, want to use distance from 0 instead of < or >
#So will make a function for comparing distance
def areclose(a, b):
    if a is None or b is None:
        return False
    T = 1e-9 #Tolerance in error
    d2 = (a[0]-b[0])**2 + (a[1]-b[1])**2
    return d2**0.5 <= T

#Also need to change how point_on_segment works
#And cannot use math.tan so need to make a function using dot product instead to test if point is on ray
def on_ray(point, ray):
    T = 1e-9
    if point is None:
        return False
    #Want vector for ray (vx, vy) and vector for ray to point (wx, wy)
    vx = np.cos(ray[1])
    vy = np.sin(ray[1])
    wx = point[0] - ray[0][0]
    wy = point[1] - ray[0][1]
    #Test that vectors are parallel using cross product = 0
    cp = vx*wy - vy*wx
    if abs(cp) > T:
        return False
    #Now check point lies on correct side of ray start point
    #Will use dot product >= 0
    dp = vx*wx + vy*wy
    if dp < -T:
        return False
    return True

def ray_segment_intersect(ray, seg):
    T = 1e-9
    if abs(ray[1] - np.pi/2) <= T:
        rayline = [1, 0, -ray[0][0]]
    elif abs(ray[1] - 3*np.pi/2) <=T:
        rayline = [1, 0, -ray[0][0]]
    else:
        rayline = [-np.tan(ray[1]), 1, ray[0][0]*np.tan(ray[1]) -ray[0][1]]
    line2 = line_from_segment(seg)
    cross = lines_intersect(rayline, line2)
    if cross is None:
        #If ray and seg are parallel, common end point but seg is not contained within ray
        if areclose(seg[0], ray[0]) and on_ray(seg[1], ray) == False:
            return ray[0]
        #Same but switched seg end points
        if areclose(seg[1], ray[0]) and on_ray(seg[0], ray) == False:
            return ray[0]
        if on_ray(seg[0], ray) or on_ray(seg[1], ray):
            return None
        else:
            return None
    if on_ray(cross, ray) and point_on_segment(cross, seg):
        x = float(cross[0])
        y = float(cross[1])
        return [x, y]


