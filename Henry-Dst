def line_from_segment(seg):
    pt1 = seg [0]
    pt2 = seg [1]
    if pt1[0] == pt2[0]:
        return [1,0,-pt1[0]] 
    dx = pt2 [0] - pt1 [0]
    dy = pt2 [1] - pt1 [1]
    a = -dy/dx
    b = 1
    c = (dy/dx)*pt1[0] - pt1[1]
    return [a,b,c]

#Want a function for distance between two points
def distance_between_points(pt1, pt2):
    x1 = pt1[0]
    y1 = pt1[1]
    x2 = pt2[0]
    y2 = pt2[1]
    d = ((x2 - x1)**2 + (y2 - y1)**2)**0.5
    return d

def point_on_segment(point, seg):
    T = 1e-9 #Tolerance
    v1 = [point[0] - seg[0][0], point[1] - seg[0][1]] 
    v2 = [point[0] - seg[1][0], point[1] - seg[1][1]]
    #Want to scale T for when segment is large
    T_scaled = T * distance_between_points(seg[0], seg[1])
    if v1[0]*v2[0] + v1[1]*v2[1] <= T_scaled:
        return True
    if point == seg[0] or point == seg[1]:
        return True
    return False

def segments_intersect(seg1,seg2):
    line1 = line_from_segment(seg1)
    line2 = line_from_segment(seg2)
    cross = lines_intersect(line1, line2)
    if cross is None:
        if point_on_segment(seg2[0], seg1) and point_on_segment(seg2[1], seg1):
            return None
        if point_on_segment(seg1[0], seg2) and point_on_segment(seg1[1], seg2):
            return None
        if (seg1[0] == seg2[0] or seg1[0] == seg2[1]) and not point_on_segment(seg1[1], seg2):
            cross = seg1[0]
        else:
            return None
    if point_on_segment(cross, seg1) and point_on_segment(cross,seg2): 
        return cross
    return None


