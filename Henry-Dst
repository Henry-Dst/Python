def lines_intersect(line1, line2):
    a1 = line1[0]
    b1 = line1[1]
    c1 = line1[2]
    a2 = line2[0]
    b2 = line2[1]
    c2 = line2[2]
    T = 1e-9 #Tolerance
    #Check if parallel
    if abs(b1) < T and abs(b2) < T:
        return None
    if abs(a2*b1 - a1*b2) < T:
        return None
    #When one is vertical
    if abs(b1) < T: #So a1 != 0 as otherwise would not have a line
        x = -c1 / a1
        y = (a2*c1 - a1*c2) / (a1*b2)
        return [x,y]
    #Now other line is vertical
    if abs(b2) < T:
        x = -c2 / a2
        y = (a1*c2 - a2*c1) / (a2*b1)
        return [x,y]
    x = (b2*c1 - b1*c2) / (a2*b1 - a1*b2)
    y = (-a1*x - c1) / b1    
    return [x,y]


