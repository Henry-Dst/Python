#Can create rays from startpoint of increasing angle and put them through multibounce to see if endpoint lies on any
#So want a function that determines how far from the path the endpoint is
#So first want a function that determines distance between point and seg
def distance_point_to_seg(point, seg):
    T = 1e-9
    if point_on_segment(point, seg):
        return 0
    dx = seg[1][0] - seg[0][0]
    dy = seg[1][1] - seg[0][1] #Seg direction vector first-second
    vx = point[0] - seg[0][0]
    vy = point[1] - seg[0][1] #First seg endpoint to point
    wx = point[0] - seg[1][0]
    wy = point[1] - seg[1][1] #Second seg endpoint to point
    mod_seg = (dx**2 + dy**2)**0.5
    if mod_seg < T: #When seg is of zero length
        return distance_between_points(point, seg[0])
    # < T functions as <= 0
    dp_first = vx*dx + vy*dy
    if dp_first < T: #Closest point is first seg endpoint
        return distance_between_points(point, seg[0])
    dp_second = -wx*dx - wy*dy #Negative because direction of seg is flipped
    if dp_second < T: #Closest point is second seg endpoint
        return distance_between_points(point, seg[1])
    if dp_first > T and dp_second > T: #Point is inbetween endpoints
        cross = abs(vx*dy - vy*dx)
        distance = cross / mod_seg
        return distance
    return None
        
def distance_point_to_path(point, path):
    if len(path) < 2:
        return None
    distance = distance_point_to_seg(point, [path[0], path[1]])
    i = 2
    while i < len(path):
        d = distance_point_to_seg(point, [path[i-1], path[i]])
        if d is not None and d < distance:
            distance = d
        i+=1
    return distance

def single_path_approx(startpoint, endpoint, seglist, window):
    T = 1e-9
    possible_paths = []
    start_to_end = [endpoint[0] - startpoint[0], endpoint[1] - startpoint[1]]
    #Will start by testing ray that points straight to endpoint
    theta_0 = math.atan2(start_to_end[1], start_to_end[0])
    #Will set maxpathlen = 20 as by this point the path should leave window
    maxpathlen = 20
    i = 0
    while i < 101:
        theta = theta_0 + i*0.0625
        path = multi_bounce([startpoint, theta], seglist, window, maxpathlen)
        d = distance_point_to_path(endpoint, path)
        if d < T: #So endpoint is on the path
            possible_paths.append(path)
            i+=1
        else:
            i+=1
    l = len(possible_paths)
    if l == 0:
        return None
    if l == 1:
        return possible_paths[0]
    if l > 1:
        shortest = possible_paths[0]
        k = 1
        while k < l:
            len_shortest = len_of_track(shortest)
            if len_of_track(possible_paths[k]) < len_shortest:
                shortest = possible_paths[k]
            k+=1
