import math

#Want a function for ray intersecting window
def ray_window_intersect(ray, window): #Are assuming the ray starts within the window
    linesegs = window_as_path(window)
    cross0 = ray_segment_intersect(ray, linesegs[0])
    cross1 = ray_segment_intersect(ray, linesegs[1])
    cross2 = ray_segment_intersect(ray, linesegs[2])
    cross3 = ray_segment_intersect(ray, linesegs[3])
    seg = [cross0, cross1, cross2, cross3]
    i = 0
    while i < len(seg):
        if seg[i] is None:
            i+=1
        else:
            cross = seg[i]
            i+=1
    return cross

def one_bounce(ray, seg, win): #Remember to consider when ray is perp to seg
    if ray_segment_intersect(ray, seg) is None:
        path = [ray[0], ray_window_intersect(ray, win)]
        return path
    else: #Avoiding trig functions due to rounding errors from float point calculations
        collide = ray_segment_intersect(ray, seg)
        #Calculate unit vector vin
        dxin = collide[0] - ray[0][0]
        dyin = collide[1] - ray[0][1]
        mod_vin = ((dxin)**2 + (dyin)**2)**0.5
        vin = np.array([dxin, dyin]) / mod_vin
        #Calculate unit segment vector s
        seg_dx = seg[1][0] - seg[0][0]
        seg_dy = seg[1][1] - seg[0][1]
        mod_seg = ((seg_dx)**2 + (seg_dy)**2)**0.5
        s = np.array([seg_dx, seg_dy]) / mod_seg
        #So the normal is -reflection of this
        n = np.array([-s[1], s[0]])
        #Want normal to be on same side of segment as the ray
        if np.dot(vin, n) > 0: #Because they should be pointing in opposite directions
            n = -n
        vout = vin - 2*n*np.dot(vin, n)
        #Now want rayout so need angle theta_out
        theta_out = math.atan2(vout[1], vout[0])
        rayout = [collide, float(theta_out)]
        #Find final part of path then put all together
        exitpoint = ray_window_intersect(rayout, win)
        path = [ray[0], collide, exitpoint]
        return path
    

