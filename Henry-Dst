#Making a variation of one_bounce that returns rayout rather than the path

def reflected_ray(rayin, seg):
    collide = ray_segment_intersect(rayin, seg)
    if collide is None:
        return None
    else: #Avoiding trig functions due to rounding errors from float point calculations
        #Calculate unit vector vin
        dxin = collide[0] - rayin[0][0]
        dyin = collide[1] - rayin[0][1]
        mod_vin = ((dxin)**2 + (dyin)**2)**0.5
        if mod_vin == 0:
            return None
        vin = np.array([dxin, dyin]) / mod_vin
        #Calculate unit segment vector s
        seg_dx = seg[1][0] - seg[0][0]
        seg_dy = seg[1][1] - seg[0][1]
        mod_seg = ((seg_dx)**2 + (seg_dy)**2)**0.5
        if mod_seg == 0:
            return None
        s = np.array([seg_dx, seg_dy]) / mod_seg
        #So the normal is perpendicular to this
        n = np.array([-s[1], s[0]])
        #Want normal to be on same side of segment as the ray
        if np.dot(vin, n) > 0: #Because they should be pointing in opposite directions
            n = -n
        vout = vin - 2*n*np.dot(vin, n)
        #Now want rayout so need angle theta_out
        theta_out = math.atan2(vout[1], vout[0])
        #Want to offset origin of rayout slightly
        T = 1e-8
        rayout = [list(np.array(collide) + T*vout), theta_out]
        return rayout
    
def multi_bounce(ray, seglist, win, maxpathlen):
    path = [ray[0]]
    rayin = ray
    i=1
    while i <= maxpathlen:
        #Want to find which seg ray collides with
        k=0
        #Possible collision points are:
        collisions = []
        while k < len(seglist):
            rayout = reflected_ray(rayin, seglist[k])
            if rayout is None:
                k+=1
            else:
                collisions.append([rayout, seglist[k]]) # list of [[start point, angle], seg]
                k+=1
        #If no collision points then ray exits window
        if len(collisions) == 0:
            exitpoint = ray_window_intersect(rayin, win)
            path.append(exitpoint)
            return path
        #Want closest collision point
        r = 1
        closest = collisions[0] #Want closest to give point, angle and segment
        while r < len(collisions):
            if distance_between_points(collisions[r][0][0], rayin[0]) < distance_between_points(closest[0][0], rayin[0]):
                closest = collisions[r] #[[start point, angle], seg]
            r+=1
        path.append(closest[0][0])
        #Want to make rayout the new rayin
        rayout = closest[0]
        rayin = rayout
        i+=1
    return path


